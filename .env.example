# AEGIS AI Configuration
# Copy this file to .env and customize as needed.
# All variables are prefixed with AEGIS_ for namespace isolation.

# System execution mode — DO NOT CHANGE from PREDICTION_ONLY.
# Live trading is strictly prohibited in this phase.
AEGIS_SYSTEM_MODE=PREDICTION_ONLY

# Primary timeframe for market analysis
AEGIS_ANALYSIS_TIMEFRAME=15m

# Database connection string (SQLite for foundation phase)
AEGIS_DATABASE_URL=sqlite:///aegis.db

# Global logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
AEGIS_LOG_LEVEL=INFO
